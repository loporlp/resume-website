---
interface Props {
  company: string;
  role: string;
  startDate: string;
  endDate?: string;
  location?: string;
  highlights: string[];
}

const { company, role, startDate, endDate = 'Present', location, highlights } = Astro.props;
---

<div class="mb-8 last:mb-0 pb-8 last:pb-0 border-b border-slate-700/30 last:border-0">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-3">
    <div>
      <h3 class="font-semibold text-white print:text-slate-900 text-lg mb-1">{role}</h3>
      <p class="text-slate-300 print:text-slate-600 font-medium">{company}</p>
    </div>
    <div class="sm:text-right shrink-0">
      <span class="text-sm text-slate-400 font-medium whitespace-nowrap">{startDate} — {endDate}</span>
      {location && <p class="text-sm text-slate-500">{location}</p>}
    </div>
  </div>

  <ul class="space-y-2.5 mt-4">
    {highlights.map((highlight) => (
      <li class="flex gap-3 text-slate-400 print:text-slate-700 text-sm leading-relaxed">
        <span class="text-blue-500 mt-1.5 text-xs">▪</span>
        <span>{highlight}</span>
      </li>
    ))}
  </ul>
</div>

---
interface SkillCategory {
  category: string;
  skills: string[];
}

interface Props {
  categories: SkillCategory[];
}

const { categories } = Astro.props;
---

<div class="space-y-6">
  {categories.map(({ category, skills }) => (
    <div>
      <h3 class="text-sm font-semibold text-blue-400 print:text-slate-700 mb-3 tracking-wide">{category}</h3>
      <div class="flex flex-wrap gap-2.5">
        {skills.map((skill) => (
          <span class="skill-tag">{skill}</span>
        ))}
      </div>
    </div>
  ))}
</div>

---
interface Props {
  institution: string;
  degree: string;
  field?: string;
  startDate: string;
  endDate?: string;
  location?: string;
  details?: string[];
}

const { institution, degree, field, startDate, endDate = 'Present', location, details } = Astro.props;
---

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3">
  <div>
    <h3 class="font-semibold text-white print:text-slate-900 text-lg mb-1">{degree}{field && ` in ${field}`}</h3>
    <p class="text-slate-300 print:text-slate-600 font-medium">{institution}</p>
    {details && details.length > 0 && (
      <div class="flex flex-wrap gap-3 mt-3">
        {details.map((detail) => (
          <span class="text-sm text-blue-400 print:text-slate-700 font-medium">{detail}</span>
        ))}
      </div>
    )}
  </div>
  <div class="sm:text-right shrink-0">
    <span class="text-sm text-slate-400 font-medium whitespace-nowrap">{startDate} — {endDate}</span>
    {location && <p class="text-sm text-slate-500">{location}</p>}
  </div>
</div>

---
interface Props {
  name: string;
  title: string;
  email?: string;
  linkedin?: string;
  github?: string;
  location?: string;
}

const { name, title, email, linkedin, github, location } = Astro.props;
---

<header class="mb-14">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6 mb-8">
    <div>
      <h1 class="text-4xl sm:text-5xl font-bold text-white print:text-slate-900 mb-2 tracking-tight">{name}</h1>
      <p class="text-xl text-blue-400 print:text-slate-600 font-medium">{title}</p>
    </div>

    <a
      href="/typstResume.pdf"
      download
      class="no-print btn-primary self-start"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
      </svg>
      Download PDF
    </a>
  </div>

  <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
    {email && (
      <a href={`mailto:${email}`} class="link-hover">
        {email}
      </a>
    )}
    {linkedin && (
      <a href={linkedin} target="_blank" rel="noopener noreferrer" class="link-hover">
        LinkedIn
      </a>
    )}
    {github && (
      <a href={github} target="_blank" rel="noopener noreferrer" class="link-hover">
        GitHub
      </a>
    )}
    {location && (
      <span class="text-slate-400 print:text-slate-600 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {location}
      </span>
    )}
  </div>
</header>
